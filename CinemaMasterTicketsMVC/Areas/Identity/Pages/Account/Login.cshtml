
@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar Sesión";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" />
}

<div class="auth-container py-5">
    <div class="auth-box addons-summary mx-auto" style="max-width: 450px;">
        <h2 class="movie-title text-center mb-4">@ViewData["Title"]</h2>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="custom-alert mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="label-select">Email</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="email@ejemplo.com" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="label-select">Contraseña</label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="******" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="mb-3 d-flex justify-content-between align-items-center">
                <label asp-for="Input.RememberMe" class="text-white-50 small" style="cursor:pointer;">
                    <input class="form-check-input me-1" asp-for="Input.RememberMe" />
                    Recordarme
                </label>
                <a id="forgot-password" asp-page="./ForgotPassword" class="text-warning small" style="text-decoration:none;">¿Olvidaste tu contraseña?</a>
            </div>

            <button id="login-submit" type="submit" class="w-100 btn btn-continuar py-2 fw-bold">ENTRAR</button>

            <div class="mt-4 text-center border-top border-secondary pt-3 opacity-75">
                <p class="mb-1">
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-info small" style="text-decoration:none;">¿No tienes cuenta? Regístrate aquí</a>
                </p>
                
            </div>
        </form>

        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="mt-4 text-center">
                <p class="text-white-50 small">O accede con</p>
                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div class="d-flex justify-content-center gap-2">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" class="btn btn-outline-light btn-sm px-4" name="provider" value="@provider.Name">@provider.DisplayName</button>
                        }
                    </div>
                </form>
            </div>
        }
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}