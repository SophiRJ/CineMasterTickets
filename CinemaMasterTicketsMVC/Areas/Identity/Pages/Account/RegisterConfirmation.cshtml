@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirmación de Registro";
}
@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" />
}
<div class="auth-container">
    <div class="auth-box addons-summary text-center">

        @* Título estilo cartelera *@
        <h1 class="movie-title mb-4">@ViewData["Title"]</h1>

        <div class="mb-4">
            @{
                if (@Model.DisplayConfirmAccountLink)
                {
                    @* Este bloque se muestra durante el desarrollo *@
                    <div class="custom-alert mb-4 text-center">
                        <i class="fas fa-info-circle me-2"></i>
                        Esta aplicación no tiene un remitente de correo real configurado.
                    </div>

                    <p class="text-white lead mb-4">
                        Normalmente recibirías un correo electrónico, pero para pruebas puedes usar el siguiente botón para activar tu cuenta:
                    </p>

                    @* Usamos la clase btn-continuar definida en el CSS *@
                    <a id="confirm-link" href="@Model.EmailConfirmationUrl" class="btn btn-continuar btn-lg w-100 py-3">
                        <i class="fas fa-user-check me-2"></i> CONFIRMAR MI CUENTA
                    </a>
                }
                else
                {
                    @* Este bloque es el que vería el usuario final *@
                    <div class="text-center">
                        <i class="fas fa-envelope-open-text fa-4x mb-4 icon-gold"></i>
                        <p class="text-white h4">
                            Por favor, revisa tu correo electrónico para confirmar tu cuenta.
                        </p>
                        <p class="text-muted small mt-3">
                            Si no encuentras el correo, revisa tu carpeta de spam.
                        </p>
                    </div>
                }
            }
        </div>

        @* Link de retorno con el estilo Cine Dark *@
        <div class="mt-4 pt-3 border-top border-secondary">
            <a asp-page="./Login" class="text-decoration-none link-return">
                <i class="fas fa-arrow-left me-2"></i> Volver al Inicio de Sesión
            </a>
        </div>

    </div>
</div>

