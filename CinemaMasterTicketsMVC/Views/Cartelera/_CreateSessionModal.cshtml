@*
    Modal para crear o editar una sesion una nueva sesión.
*@
@model CinemaMasterTicketsMVC.Models.Session

<div class="modal fade" id="sessionModal" tabindex="-1">
    <div class="modal-dialog">
        <form id="sessionForm" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Añadir sesión</h5>
                @* Botón de la para cerrar la ventana *@
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                @* este es un letrero de aviso escondido -> (d-none)
                   que solo se mostrara si el servidor da algun error*@
                <div id="session-error" class="alert alert-danger d-none"></div>

                @*mandamos ocultos el Id de la sesión y de la película  *@
                <input type="hidden" id="sessionId" asp-for="SessionId" />
                <input type="hidden" id="movieId" asp-for="MovieId" />

                @* campo para elegir el día y la hora *@
                <div class="mb-2">
                    <label asp-for="StartTime">Hora inicio</label>
                    <input type="datetime-local" id="startTime" asp-for="StartTime" class="form-control"
                           min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                    <span asp-validation-for="StartTime" class="text-danger small"></span>
                </div>

                @* Lista desplegable para elegir la sala de la película *@
                <div class="mb-2">
                    <label asp-for="RoomId">Sala</label>
                    <select id="roomId" asp-for="RoomId" class="form-control">
                        <option value="">Seleccione una sala</option>
                        @* Recorremos la lista de salas que recibimos para crear las opciones *@
                        @foreach (var room in ViewBag.Rooms! as IEnumerable<CinemaMasterTicketsMVC.Models.Room>)
                        {
                            <option value="@room.RoomId">@room.RoomId</option>
                        }
                    </select>
                    <span asp-validation-for="RoomId" class="text-danger small"></span>
                </div>
                @* Campo para l precio de la entrada *@
                <div class="mb-2">
                    <label asp-for="Price">Precio</label>
                    <input type="number" step="0.01" id="price" asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
            </div>
            @* Boton final para intentar guardar, al pulsarlo se activa la función de JS saveSesion() *@
            <div class="modal-footer">
                <button type="button" class="btn btn-success" id="btnSaveSession">Guardar</button>
            </div>
        </form>
    </div>
</div>