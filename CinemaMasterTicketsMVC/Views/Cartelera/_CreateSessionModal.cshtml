@*
    Modal para crear una nueva sesión.
    - Se abre cuando el usuario hace clic en "Añadir sesión" en la cartelera.
    - Contiene campos para:
        - Muestra error en casa de que la sala no este disponible y no se pueda crear la sesion
        - MovieId (hidden, se asigna desde JS)
        - Hora de inicio (datetime-local, no permite fechas pasadas)
        - Sala (select list, cargada dinámicamente desde ViewBag.Rooms)
        - Precio
    - El botón "Guardar" llama a la función saveSession() del JS.
*@

<div class="modal fade" id="sessionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Añadir sesión</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                @* mostrar error en caso de que no se pueda crear la sesion por que la sala no este disponible *@
                <div id="session-error" class="alert alert-danger d-none"></div>
                @* id de sesion *@
                <input type="hidden" id="sessionId" />
                @* Input hidden para almacenar el MovieId de la película seleccionada *@
                <input type="hidden" id="movieId" />

                @* Campo para q la hora de inicio sea > a hoy *@
                <div class="mb-2">
                    <label>Hora inicio</label>
                    <input type="datetime-local" id="startTime" class="form-control"
                           min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                </div>

                @* Lista desplegable de salas *@
                <div class="mb-2">
                    <label>Sala</label>
                    <select id="roomId" class="form-control">
                        <option value="">Seleccione una sala</option>
                        @foreach (var room in ViewBag.Rooms as IEnumerable<CinemaMasterTicketsMVC.Models.Room>)
                        {
                            <option value="@room.RoomId">@room.RoomId</option>
                        }
                    </select>
                </div>

                @* Campo para el precio de la sesión *@
                <div class="mb-2">
                    <label>Precio</label>
                    <input type="number" step="0.01" id="price" class="form-control" />
                </div>
            </div>

            <div class="modal-footer">
                @* Botón para guardar la sesión, llama a saveSession() en JS *@
                <button class="btn btn-success" onclick="saveSession()">Guardar</button>
            </div>


        </div>
    </div>
</div>