
@model IEnumerable<CinemaMasterTicketsMVC.Models.Movie>

@section Styles {
    <link rel="stylesheet" href="~/css/getSessions.css" />
}

<div class="container pb-5 mt-4">
<div class="row g-4">
    @foreach (var movie in Model)
    {
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="row g-0">
                    <div class="col-md-3">
                        <img src="@movie.PosterUrl"
                             class="img-fluid rounded-start"
                             alt="@movie.Title" />
                    </div>

                    <div class="col-md-9">
                        <div class="card-body">
                            <h4>@movie.Title</h4>
                            <p class="text-muted mb-1">
                                @* @movie.Genre ·  *@@movie.DurationMinutes min
                            </p>

                            <div class="d-flex gap-2 mb-3">
                                <div class="d-flex gap-2 mb-3">
                                    @* <button class="btn btn-outline-primary btn-sm"
                                            onclick="loadSessions(@movie.MovieId)">
                                        Ver sesiones
                                    </button>

                                    <button class="btn btn-success btn-sm"
                                            onclick="openSessionModal(@movie.MovieId)">
                                        Añadir sesión
                                    </button> *@
                                    @* REFACTORIZADO: Clases para identificar y data-id para el valor *@
                                    <button class="btn btn-outline-primary btn-sm btn-load-sessions"
                                            data-movie-id="@movie.MovieId">
                                        Ver sesiones
                                    </button>

                                    <button class="btn btn-success btn-sm btn-add-session"
                                            data-movie-id="@movie.MovieId">
                                        Añadir sesión
                                    </button>
                                </div>

                            </div>

                            <div id="sessions-@movie.MovieId"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
    }
</div>
</div>

@await Html.PartialAsync("_CreateSessionModal")
@section Scripts {
    <script src="~/js/cartelera.js"></script>
}