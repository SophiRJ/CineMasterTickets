@model IEnumerable<CinemaMasterTicketsMVC.Models.Movie> // Recibe la lista de películas para mostrar

@* Referencia al archivo de estilos *@
@section Styles { 
    <link rel="stylesheet" href="~/css/getSessions.css" />
}

<div class="container pb-5 mt-4">
<div class="row g-4">
    @foreach (var movie in Model)// Itera sobre cada película en la base de datos
    {
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="row g-0">
                    <div class="col-md-3">
                        <img src="@movie.PosterUrl"
                             class="img-fluid rounded-start"
                             alt="@movie.Title" />
                    </div>

                    <div class="col-md-9">
                        <div class="card-body">
                            <h4>@movie.Title</h4>
                            <p class="text-muted mb-1">
                                @movie.DurationMinutes min
                            </p>

                            <div class="d-flex gap-2 mb-3">
                                <div class="d-flex gap-2 mb-3">
                                    @* Bton parqa cargar sesiones usa un data-atribute para pasar el id a JS *@
                                    <button class="btn btn-outline-primary btn-sm btn-load-sessions"
                                            data-movie-id="@movie.MovieId">
                                        Ver sesiones
                                    </button>
                                    @* Bton para añdir sesiones usa un data-atribute, para mediante JS se abra el modal para creae la sesion *@ 
                                    <button class="btn btn-success btn-sm btn-add-session"
                                            data-movie-id="@movie.MovieId">
                                        Añadir sesión
                                    </button>
                                </div>

                            </div>
                            @* Aqui se creara mediante JS el html mediante una vista parcial de sesiones *@
                            <div id="sessions-@movie.MovieId"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
    }
</div>
</div>

@* @await Html.PartialAsync("_CreateSessionModal") *@
@await Html.PartialAsync("_CreateSessionModal", new CinemaMasterTicketsMVC.Models.Session())
@section Scripts {
    @*  cargamos las librerías de validación de jQuery, luego nuestro script *@
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/cartelera.js"></script>
}