@model IEnumerable<CinemaMasterTicketsMVC.Models.Session>
<table class="table table-hover">
    <thead>
        <tr>
            <th>Película</th>
            <th>Sala</th>
            <th>Inicio</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Movie?.Title</td>
                <td>@s.Room?.RoomId</td>
                <td>@s.StartTime.ToString("dd/MM HH:mm")</td>
            </tr>
        }
    </tbody>
</table>