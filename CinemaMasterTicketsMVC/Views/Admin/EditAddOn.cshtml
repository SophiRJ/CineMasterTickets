@model CinemaMasterTicketsMVC.Models.AddOn

@section Styles {
    <link rel="stylesheet" href="~/css/seatAddOn.css" />
}

@{
    ViewData["Title"] = "Editar AddOn";
}

<h2 class="text-light mb-4 movie-title">Modificar Complemento</h2>

<div class="addons-summary">
    <form asp-action="EditAddOn" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="AddOnId" />

        <div class="row">
            <div class="col-md-8">
                <div class="mb-3">
                    <label asp-for="AddOnName" class="label-select">Nombre</label>
                    <input asp-for="AddOnName" class="form-control form-select" />
                    <span asp-validation-for="AddOnName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="label-select">Precio (€)</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control form-select" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Type" class="label-select">Categoría</label>
                    <select asp-for="Type" asp-items="ViewBag.AddOnTypes" class="form-select"></select>
                </div>
            </div>

            <div class="col-md-4 text-center">
                <label class="label-select">Imagen Actual</label>
                @if (!string.IsNullOrEmpty(Model.AddOnImage))
                {
                    <img src="~/@Model.AddOnImage" class="addon-img-thumbnail mb-3" style="width: 150px; height: 150px;" />
                }
                <input asp-for="AddOnImageFile" type="file" class="form-control form-select" />
            </div>
        </div>

        <div class="d-flex gap-3 mt-4">
            <button type="submit" class="btn btn-continuar p-2 px-4">Actualizar Cambios</button>
            <a asp-action="GetAddons" class="btn btn-cancelar p-2 px-4">Volver</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}