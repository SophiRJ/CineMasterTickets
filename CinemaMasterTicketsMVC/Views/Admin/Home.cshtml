@*Conexion a su archivo de estilos  *@
@section Styles {
    <link rel="stylesheet" href="~/css/adminHome.css" />
}
@{
    ViewData["Title"] = "Panel de Administración";
}

<div class="container mt-4">

    <h1 class="mb-4 text-center text-light">Panel de Administración</h1>

    <div class="row g-4">

        <!-- USUARIOS -->
        <div class="col-md-4">
            <a asp-action="Index" class="text-decoration-none">
                <div class="card shadow-lg h-100 border-0 admin-card users-card">
                    <div class="card-body text-center">
                        <i class="bi bi-people-fill admin-icon"></i>
                        <h4 class="mt-3">Usuarios</h4>
                        <p>Gestión de empleados y clientes</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- CARTELERA -->
        <div class="col-md-4">
            <a asp-action="SelectFilmsAPI" class="text-decoration-none">
                <div class="card shadow-lg h-100 border-0 admin-card movies-card">
                    <div class="card-body text-center">
                        <i class="bi bi-film admin-icon"></i>
                        <h4 class="mt-3">Cartelera</h4>
                        <p>Gestión de películas</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- ADDONS -->
        <div class="col-md-4">
            <a asp-action="GetAddons" class="text-decoration-none">
                <div class="card shadow-lg h-100 border-0 admin-card addons-card">
                    <div class="card-body text-center">
                        <i class="bi bi-cup-straw admin-icon"></i>
                        <h4 class="mt-3">AddOns</h4>
                        <p>Comida, bebida y extras</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- VENTAS -->
        <div class="col-md-4">
            <a asp-action="Sales" class="text-decoration-none">
                <div class="card shadow-lg h-100 border-0 admin-card sales-card">
                    <div class="card-body text-center">
                        <i class="bi bi-ticket-perforated-fill admin-icon"></i>
                        <h4 class="mt-3">Ventas</h4>
                        <p>Tickets vendidos</p>
                    </div>
                </div>
            </a>
        </div>

       @*  <!-- REPORTES -->
        <div class="col-md-4">
            <a asp-action="Reports" class="text-decoration-none">
                <div class="card shadow-lg h-100 border-0 admin-card reports-card">
                    <div class="card-body text-center">
                        <i class="bi bi-bar-chart-fill admin-icon"></i>
                        <h4 class="mt-3">Reportes</h4>
                        <p>Estadísticas y métricas</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- CONFIGURACIÓN -->
        <div class="col-md-4">
            <a asp-action="Settings" class="text-decoration-none">
                <div class="card shadow-lg h-100 border-0 admin-card settings-card">
                    <div class="card-body text-center">
                        <i class="bi bi-gear-fill admin-icon"></i>
                        <h4 class="mt-3">Configuración</h4>
                        <p>Parámetros del sistema</p>
                    </div>
                </div>
            </a>
        </div> *@

    </div>
</div>
