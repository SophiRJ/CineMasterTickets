@* Vista para manejar los usuarios y listado de empleados*@ 
@model CinemaMasterTicketsMVC.ViewModels.AdminUsersPanelViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/adminHome.css" />
}

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container management-container py-4">
    @Html.AntiForgeryToken()

    @* Cabecera Principal *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white fw-bold"><i class="fas fa-users-cog me-2 text-warning"></i>Gestión de Usuarios</h2>
        <div class="d-flex gap-2">
            @* Botones para crear empleado y volver atras*@
            <a asp-action="CreateEmployee" class="btn btn-warning rounded-pill px-4">
                <i class="fas fa-user-plus me-2"></i>Nuevo Empleado
            </a>
            <a asp-action="Home" asp-controller="Admin" class="btn btn-outline-light rounded-pill px-4">
                <i class="fas fa-arrow-left me-2"></i>Panel Admin
            </a>
        </div>
    </div>

    @* Sección Empleados donde se muestran los empleados que hay, junto con botones de ver perfil, editar y borrar *@
    <div class="card bg-dark mb-5 border-secondary shadow-sm">
        <div class="card-header border-secondary">
            <h4 class="text-warning mb-0"><i class="fas fa-user-tie me-2"></i>Staff del Cine</h4>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th class="ps-4">Nombre y Apellidos</th>
                            <th>Email</th>
                            <th>Taquilla</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Model.Employees)
                        {
                            <tr id="row-employee-@emp.EmployeeId">
                                <td class="ps-4 fw-bold text-white">@emp.Firstname @emp.Lastname</td>
                                <td class="text-white-50">@emp.Email</td>
                                <td>
                                    <span class="badge rounded-pill bg-info">
                                        <i class="fas fa-desktop me-1"></i>@(emp.BoxOffice?.BoxOfficeName ?? "No asignada")
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group gap-1">
                                        @* Aqui situamos los botones de Editar, ver perfil y borrar empleados*@
                                        <a asp-action="Index" asp-controller="Employee" asp-route-id="@emp.EmployeeId"
                                           class="btn btn-sm btn-outline-info" title="Ver Perfil"><i class="fas fa-eye"></i></a>
                                        <a asp-action="Edit" asp-controller="Employee" asp-route-id="@emp.EmployeeId"
                                           class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i></a>
                                        <button type="button" class="btn-delete-item btn btn-sm btn-outline-danger"
                                                data-id="@emp.EmployeeId" data-name="@emp.Firstname" data-type="Employee">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* Sección Clientes, funciona de la misma forma que el de empleados, solo que en esta vista no se pueden crear *@
    <div class="card bg-dark border-secondary shadow-sm">
        <div class="card-header border-secondary">
            <h4 class="text-danger mb-0"><i class="fas fa-user-friends me-2"></i>Clientes del Club</h4>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th class="ps-4">Cliente</th>
                            <th>Email</th>
                            <th>Puntos</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cli in Model.Customers)
                        {
                            <tr id="row-customer-@cli.CustomerId">
                                <td class="ps-4 text-white">@cli.FirstName @cli.LastName</td>
                                <td class="text-white-50">@cli.Email</td>
                                <td>
                                    <span class="text-warning-points"><i class="fas fa-ticket-alt me-2"></i>@cli.FidelityPoints</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group gap-1">
                                        <a asp-action="Index" asp-controller="Customer" asp-route-id="@cli.CustomerId"
                                           class="btn btn-sm btn-outline-info"><i class="fas fa-eye"></i></a>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-managament.js"></script>
}