@model CinemaMasterTicketsMVC.Models.Customer

@{
    ViewData["Title"] = "Darme de baja";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0"><i class="bi bi-exclamation-triangle"></i> ¡Advertencia importante!</h3>
                </div>
                <div class="card-body p-4">
                    <h4 class="text-danger">¿Seguro que quieres darte de baja, @Model.FirstName?</h4>
                    <p class="lead">Esta acción es irreversible. Si continúas, perderás:</p>

                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item text-dark">
                            <strong>❌ Tus puntos acumulados:</strong> Actualmente tienes @Model.FidelityPoints puntos.
                        </li>
                        <li class="list-group-item text-dark">
                            <strong>❌ Ventajas exclusivas:</strong> Perderás el acceso a los descuentos del Club.
                        </li>
                        <li class="list-group-item text-dark">
                            <strong>❌ Historial:</strong> No podrás consultar tus pedidos anteriores.
                        </li>
                    </ul>

                    <div class="alert alert-warning">
                        <p class="mb-0 small">Si deseas volver en el futuro, tendrás que realizar un nuevo registro desde cero.</p>
                    </div>

                    <form asp-action="UnsubscribeConfirmed"  method="post">
                        @* Es vital incluir el antiforgery token por seguridad *@
                        @Html.AntiForgeryToken()

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary">
                                No, quiero quedarme
                            </a>
                            <button type="submit" class="btn btn-danger">
                                Sí, eliminar mi cuenta definitivamente
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>