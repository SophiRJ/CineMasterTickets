<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow">
    <title>@ViewData["Title"] - CinemaMasterTicketsMVC</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="~/CinemaMasterTicketsMVC.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/popup-edu.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="background-icon">
        <i class="fas fa-film"></i>
    </div>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">CinemaMasterTicketsMVC</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - CinemaMasterTicketsMVC - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="eduToast" class="toast addons-summary border-warning" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="10000">
            <div class="toast-header bg-transparent border-0">
                <i class="fas fa-graduation-cap text-warning me-2"></i>
                <strong class="me-auto movie-title fs-6">AVISO PROYECTO</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body text-light small">
                <p class="mb-2">
                    Esta es una aplicación desarrollada con <strong>fines exclusivamente educativos y demostrativos</strong>.
                </p>

                <div class="mb-1">
                    <i class="fas fa-user-shield text-warning me-1"></i>
                    No introduzca datos personales reales ni información sensible.
                </div>

                <div class="mb-1">
                    <i class="fas fa-database text-info me-1"></i>
                    Los datos ingresados no se utilizan con fines comerciales ni de seguimiento.
                </div>

                <div class="mb-1">
                    <i class="fas fa-trash-alt text-danger me-1"></i>
                    La información almacenada es temporal y se elimina periódicamente.
                </div>

                <div class="mt-2 pt-2 border-top border-secondary opacity-75">
                    <div class="mb-1">
                        <i class="fas fa-film text-warning me-1"></i>
                        La información de películas y series se obtiene desde la API pública de
                        <strong>The Movie Database (TMDB)</strong>.
                    </div>
                    <div class="text-white-50">
                        Este proyecto no está afiliado, respaldado ni certificado por TMDB.
                        Los datos se muestran únicamente con fines informativos.
                    </div>
                </div>

                <div class="mt-2 pt-2 border-top border-secondary opacity-50 text-center">
                    <span class="text-white-50">Se cerrará automáticamente...</span>
                </div>
            </div>

        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/popup-edu.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
