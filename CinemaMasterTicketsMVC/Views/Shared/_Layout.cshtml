<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CinemaMasterTicketsMVC</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="~/CinemaMasterTicketsMVC.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="background-icon">
        <i class="fas fa-film"></i>
    </div>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid p-0">
               
                <a class="navbar-brand m-0 p-0" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/img/logo/LogoSuperior.PNG" alt="Cinema Master Tickets" class="nav-logo">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="Home">Admin</a>
                            </li>
                        }
                        @if (User.IsInRole("Customer") )
                             {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Customer" asp-action="Index">Perfil Cliente</a>
                            </li>
                        }
                        @if (User.IsInRole("Employee") )
                             {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Employee" asp-action="Index">Perfil Empleado</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-cinema mt-auto py-4">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-4 text-center text-md-start mb-3 mb-md-0">
                    <h5 class="highlight-gold mb-0">CINEMA MASTER TICKETS</h5>
                    <p class="small text-muted mb-0">&copy; @DateTime.Now.Year - Proyecto Educativo</p>
                </div>

                <div class="col-md-4 text-center mb-3 mb-md-0">
                    <div class="tmdb-attribution">
                        <img src="https://www.themoviedb.org/assets/2/v4/logos/v2/blue_short-8e7b30f73a4020692ccca9c88bafe5dcb6f8a62a4c6bc55cd9ba82bb2cd95f6c.svg"
                             alt="TMDB Logo" class="tmdb-logo mb-2" />
                        <p class="tmdb-text">
                            This website uses TMDB and the TMDB APIs but is not endorsed, certified, or otherwise approved by TMDB.
                        </p>
                    </div>
                </div>

                <div class="col-md-4 text-center text-md-end">
                    <div class="footer-links">
                        <a asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none small me-3">Privacidad</a>
                        <span class="text-muted small">|</span>
                        <a asp-controller="Home" asp-action="Legal" class="text-muted text-decoration-none small me-3">Terminos Legales</a>
                    </div>
                </div>
            </div>

            <hr class="border-secondary my-3" />
            <div class="text-center">
                <p class="disclaimer-text">
                    <i class="bi bi-exclamat-triangle-fill me-1"></i>
                    <strong>Aviso:</strong> Esta es una aplicación de simulación con fines puramente académicos. No se realizan transacciones reales.
                </p>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
