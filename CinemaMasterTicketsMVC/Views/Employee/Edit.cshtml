@model CinemaMasterTicketsMVC.Models.Employee

@{
    ViewData["Title"] = "Editar Mis Datos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile-employee.css" />
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg cinema-profile-card">

                @* Encabezado con foto actual (Solo lectura) *@
                <div class="card-header employee-header text-center">
                    <img src="~/@(Model.ProfileImage ?? "img/default-employee.png")"
                         class="rounded-circle employee-avatar mb-2" style="width: 100px; height: 100px;" />
                    <h4 class="text-employee mb-0">Mis Datos Personales</h4>
                    <p class="text-muted small">Para cambiar la foto, hazlo desde tu perfil principal</p>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        @* Campos ocultos necesarios *@
                        <input type="hidden" asp-for="EmployeeId" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Firstname" class="form-label small text-muted text-uppercase">Nombre</label>
                                <input asp-for="Firstname" class="form-control bg-dark text-white border-secondary" />
                                <span asp-validation-for="Firstname" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Lastname" class="form-label small text-muted text-uppercase">Apellidos</label>
                                <input asp-for="Lastname" class="form-control bg-dark text-white border-secondary" />
                                <span asp-validation-for="Lastname" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="DNI" class="form-label small text-muted text-uppercase">DNI / NIF</label>
                                <input asp-for="DNI" class="form-control bg-dark text-white border-secondary" />
                                <span asp-validation-for="DNI" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label small text-muted text-uppercase opacity-50">Correo Electrónico (No editable)</label>
                                <input value="@Model.Email" class="form-control bg-dark text-white border-secondary opacity-50" disabled />
                            </div>

                            <div class="col-12 mt-4 d-grid gap-2">
                                <button type="submit" class="btn btn-employee-primary py-2 rounded-pill">
                                    <i class="fas fa-save me-2"></i>Guardar Cambios
                                </button>
                                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill py-2">
                                    Regresar al Perfil
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
