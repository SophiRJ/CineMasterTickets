@model CinemaMasterTicketsMVC.Models.Employee

@{
    ViewData["Title"] = "Panel de Control Staff";
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile-employee.css" />
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-7">

            @* Alertas de éxito/error *@
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert" style="background-color: #005f73; color: white;">
                    <i class="fas fa-check-circle me-2"></i> @TempData["Message"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card border-0 shadow-lg overflow-hidden cinema-profile-card">

                @* HEADER CON FOTO *@
                <div class="employee-header text-center">
                    <div class="position-relative d-inline-block">
                        <img src="~/@(Model.ProfileImage ?? "img/default-employee.png")"
                             class="rounded-circle employee-avatar shadow-lg"
                             alt="Foto de perfil" />

                        @* Botón de cámara para subir foto *@
                        <button type="button" class="btn btn-employee-camera btn-sm rounded-circle position-absolute bottom-0 end-0"
                                onclick="document.getElementById('fileInput').click()" title="Cambiar foto">
                            <i class="fas fa-camera"></i>
                        </button>
                    </div>
                </div>

                <div class="card-body p-4">
                    @* NOMBRE Y PUESTO *@
                    <div class="text-center mb-4">
                        <h2 class="fw-bold mb-1 employee-name">@Model.Firstname @Model.Lastname</h2>
                        <p class="text-uppercase fw-bold employee-staff-tag">DNI: @Model.DNI</p>
                    </div>

                    @* DASHBOARD DE RENDIMIENTO *@
                    <div class="row g-3 mb-4">
                        <div class="col-md-6 text-center">
                            <div class="employee-stats-badge">
                                <small class="d-block text-uppercase opacity-75">Ventas de Hoy</small>
                                <span class="h2 m-0 fw-bold">@Model.VentasHoy</span>
                                <p class="mb-0 small" style="font-size: 0.7rem;">Tickets emitidos hoy</p>
                            </div>
                        </div>
                        <div class="col-md-6 text-center">
                            <div class="employee-stats-badge">
                                <small class="d-block text-uppercase opacity-75">Taquilla</small>
                                <span class="h4 d-block mt-2 fw-bold text-truncate">
                                    @(Model.BoxOffice?.BoxOfficeName ?? "N/A")
                                </span>
                                <p class="mb-0 small" style="font-size: 0.7rem;">Punto de venta actual</p>
                            </div>
                        </div>
                    </div>

                    @* TABLA DE ÚLTIMAS VENTAS (Usando la propiedad TicketsHoy) *@
                    <div class="employee-info-box">
                        <h6 class="text-employee mb-3">
                            <i class="fas fa-history me-2"></i>Últimas 5 ventas del día
                        </h6>

                        @if (Model.TicketsHoy.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-dark table-hover mb-0" style="font-size: 0.85rem; border-color: #333;">
                                    <thead>
                                        <tr class="text-muted">
                                            <th>Hora</th>
                                            <th>ID Ticket</th>
                                            <th class="text-end">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var ticket in Model.TicketsHoy.Take(5))
                                        {
                                            <tr>
                                                <td class="align-middle">@ticket.PurchasedAt!.Value.ToString("HH:mm")</td>
                                                <td class="align-middle text-info">#@ticket.TicketId</td>
                                                <td class="text-end align-middle fw-bold">@ticket.TotalPrice.ToString("F2") €</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-3">
                                <p class="text-muted mb-0 small">No hay ventas registradas este día.</p>
                            </div>
                        }
                    </div>

                    @* FORMULARIO OCULTO PARA SUBIDA AUTOMÁTICA DE FOTO *@
                    <form asp-action="UploadPhoto" method="post" enctype="multipart/form-data" id="photoForm" class="d-none">
                        <input asp-for="ProfileImageFile" type="file" id="fileInput" accept="image/*" onchange="document.getElementById('photoForm').submit()" />
                    </form>

                    @* BOTONES DE ACCIÓN *@
                    <div class="d-grid gap-3 mt-4">
                        <div class="row g-2">
                            <div class="col-6">
                                <a asp-action="Edit" class="btn btn-outline-employee rounded-pill w-100 py-2">
                                    <i class="fas fa-user-edit me-2"></i>Mis Datos
                                </a>
                            </div>
                            <div class="col-6">
                                <a asp-controller="Ticket" asp-action="Create" class="btn btn-employee-primary rounded-pill w-100 py-2">
                                    <i class="fas fa-plus-circle me-2"></i>Nueva Venta
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top border-secondary text-start">
                        <small class="text-muted d-block text-uppercase" style="font-size: 0.6rem;">Email de contacto corporativo</small>
                        <span class="small">@Model.Email</span>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Opcional: Auto-cerrar alertas después de 5 segundos
        window.setTimeout(function() {
            $(".alert").fadeTo(500, 0).slideUp(500, function(){
                $(this).remove();
            });
        }, 5000);
    </script>
}
