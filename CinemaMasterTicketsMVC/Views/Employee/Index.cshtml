@model CinemaMasterTicketsMVC.Models.Employee

@{
    ViewData["Title"] = "Panel de Control Staff";
}

@section Styles {
    @*Referencia a su archivo de estilos *@
    <link rel="stylesheet" href="~/css/profile-index.css" />
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-7">

            @* Notificaciones ->muestra mensajes de exito al actualizar datos o subir fotos *@
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-staff alert-dismissible fade show mb-4 border-0 shadow" role="alert">
                    <i class="fas fa-star me-2"></i> @TempData["Message"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card border-0 shadow-lg overflow-hidden cinema-profile-card">

                @* Encabezado -> foto de perfil *@
                <div class="employee-header">
                    <div class="position-relative d-inline-block">
                        <img src="~/@(Model.ProfileImage ?? "img/default-employee.png")"
                             class="rounded-circle employee-avatar shadow-lg" />

                        @* Boton de la camara que dispara el input de archivo oculto más abajo *@
                        <button type="button" class="btn btn-employee-camera btn-sm rounded-circle position-absolute bottom-0 end-0"
                                onclick="document.getElementById('fileInput').click()">
                            <i class="fas fa-camera"></i>
                        </button>
                    </div>
                </div>

                <div class="card-body p-4">
                    @*Identificacion -> nombre completo y DNI corporativo *@
                    <div class="text-center mb-4">
                        <h2 class="fw-bold mb-1 employee-name">@Model.Firstname @Model.Lastname</h2>
                        <p class="text-uppercase fw-bold employee-staff-tag mb-0">DNI: @Model.DNI</p>
                    </div>

                    @* Aqu se muestra un resumen rapido de la actividad del empleado en el día *@
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="employee-stats-badge text-center">
                                <small class="d-block text-uppercase opacity-75 fw-bold">Ventas de Hoy</small>
                                <span class="h2 m-0 fw-bold">@Model.VentasHoy</span>
                                <p class="mb-0">Tickets emitidos</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="employee-stats-badge text-center">
                                <small class="d-block text-uppercase opacity-75 fw-bold">Taquilla</small>
                                <span class="h4 d-block mt-2 fw-bold text-truncate">
                                    @(Model.BoxOffice?.BoxOfficeName ?? "N/A")
                                </span>
                                <p class="mb-0">Punto de venta</p>
                            </div>
                        </div>
                    </div>

                    @*seccion que muestra las ultimas ventas para control del empleado *@
                    <div class="employee-info-box">
                        <h6 class="text-employee mb-3">
                            <i class="fas fa-history me-2"></i>Últimas 5 ventas
                        </h6>

                        @if (Model.TicketsHoy != null && Model.TicketsHoy.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-dark table-hover mb-0 cinema-table">
                                    <thead>
                                        <tr class="text-muted border-bottom border-secondary">
                                            <th>Hora</th>
                                            <th>ID Ticket</th>
                                            <th class="text-end">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var ticket in Model.TicketsHoy.Take(5))
                                        {
                                            <tr>
                                                <td class="align-middle">@ticket.PurchasedAt?.ToString("HH:mm")</td>
                                                <td class="align-middle text-warning">#@ticket.TicketId</td>
                                                <td class="text-end align-middle fw-bold">@ticket.TotalPrice.ToString("F2") €</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-2">
                                <p class="text-muted mb-0 small">No hay ventas hoy.</p>
                            </div>
                        }
                    </div>

                    @* Formulario oculto para la gestion de la foto que se envía automáticamente al elegir una imagen *@
                    <form asp-action="UploadPhoto" method="post" enctype="multipart/form-data" id="photoForm" class="d-none">
                        <input asp-for="ProfileImageFile" type="file" id="fileInput" accept="image/*" onchange="document.getElementById('photoForm').submit()" />
                    </form>

                    @* botones de accion cambian dependiendo si el que mira el perfil es el Admin o el empleado *@
                    <div class="d-grid gap-3 mt-4">
                        <div class="row g-2">
                            <div class="col-6">
                                <a asp-action="Edit" asp-route-id="@(User.IsInRole("Admin") ? Model.EmployeeId : null)"
                                   class="btn btn-employee-secondary rounded-pill w-100 py-2 text-decoration-none">
                                    <i class="fas @(User.IsInRole("Admin") ? "fa-user-shield" : "fa-user-edit") me-2"></i>Perfil
                                </a>
                            </div>
                            <div class="col-6">
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-controller="Admin" asp-action="Index" class="btn btn-employee-primary rounded-pill w-100 py-2 text-decoration-none">
                                        <i class="fas fa-list me-2"></i>Lista Usuarios
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="Home" asp-action="Index" class="btn btn-employee-primary rounded-pill w-100 py-2 text-decoration-none">
                                        <i class="fas fa-plus-circle me-2"></i>Nueva Venta
                                    </a>
                                }
                            </div>
                        </div>
                    </div>

                    @* Información de contacto de la empresa *@
                    <div class="mt-4 pt-3 border-top border-secondary text-center">
                        <small class="cinema-label">Contacto Corporativo</small>
                        <span class="small text-white-50">@Model.Email</span>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>