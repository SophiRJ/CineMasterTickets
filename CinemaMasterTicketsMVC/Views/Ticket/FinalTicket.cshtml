@model CinemaMasterTicketsMVC.ViewModels.TicketViewModel

@{
    ViewData["Title"] = "¡Compra Confirmada!";
}

@section Styles {
    <link rel="stylesheet" href="~/css/ticket.css" asp-append-version="true" />
}

<div class="container my-5 main-ticket-wrapper">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card ticket-visual">
                <div class="card-header text-center">
                    <h2 class="display-6">CINEMA MASTER TICKETS</h2>
                    <p class="small">@DateTime.Now.ToString("f")</p>
                </div>

                <div class="card-body">
                    <div class="text-center mb-4">
                        <h3 class="fw-bold">@Model.MovieTitle</h3>
                        <p>SALA @Model.RoomNumber | @Model.SessionTime</p>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <span>ASIENTOS:</span>
                        <span class="fw-bold">@string.Join(", ", Model.SelectedSeats)</span>
                    </div>

                    @if (Model.Addons.Any())
                    {
                        <hr />
                        <p class="small fw-bold mb-1">COMPLEMENTOS</p>
                        @foreach (var item in Model.Addons)
                        {
                            <div class="d-flex justify-content-between small">
                                <span>@item.Quantity x @item.Name</span>
                                <span>@((item.Quantity * item.UnitPrice).ToString("0.00")) €</span>
                            </div>
                        }
                    }

                    <hr />

                    <div class="d-flex justify-content-between total-row">
                        <span class="h5">TOTAL:</span>
                        <span class="h5 fw-bold">@Model.TotalGeneral.ToString("0.00") €</span>
                    </div>

                    <div class="text-center mt-4 qr-container">
                        <div id="qrcode" data-ticket-id="@ViewBag.TicketId"></div>
                        <p class="small mt-2">ID: #@ViewBag.TicketId</p>
                    </div>
                    @* --- NUEVA SECCIÓN DE AVISO LEGAL DENTRO DEL TICKET --- *@
                    <div class="educational-disclaimer mt-4">
                        <p class="mb-0 text-uppercase fw-bold">Sin Validez Comercial</p>
                        <p class="small">
                            Este documento es un comprobante generado exclusivamente para un **Proyecto Educativo de Final de Módulo**.
                            No posee validez legal, fiscal ni comercial. No autoriza el acceso a ninguna sala de cine real.
                        </p>
                    </div>
                </div>

                <div class="card-footer text-center">
                    <p class="mb-0">¡Disfrute de la película!</p>
                </div>
            </div>

            @* --- AVISO FUERA DEL TICKET (Para cumplimiento normativo en la web) --- *@
            <div class="alert alert-warning mt-4 action-buttons" role="alert">
                <i class="bi bi-info-circle-fill"></i>
                <strong>Aviso Académico:</strong> Esta aplicación es un simulador desarrollado con fines didácticos.
                Los datos mostrados, marcas y sesiones son ficticios. Cinema Master Tickets es una marca inventada.
            </div>
                
            <div class="text-center mt-4 action-buttons">
                <button onclick="window.print();" class="btn btn-primary">
                    <i class="bi bi-printer"></i> Imprimir Ticket
                </button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Salir</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bwip-js@3.0.4/dist/bwip-js-min.js"></script>
    <script src="~/js/ticket-qr.js" asp-append-version="true"></script>
}

@* @model CinemaMasterTicketsMVC.ViewModels.TicketViewModel

@{
    ViewData["Title"] = "¡Compra Confirmada!";
}
@section Styles {
    <link rel="stylesheet" href="~/css/ticket.css" asp-append-version="true" />
}
<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-success text-white text-center py-4">
                    <i class="bi bi-check-circle-fill fs-1"></i>
                    <h2 class="mt-2">¡Gracias por su compra!</h2>
                    <p class="mb-0">Su entrada ha sido procesada correctamente</p>
                </div>

                <div class="card-body p-5">
                    <div class="d-flex justify-content-between border-bottom pb-3 mb-4">
                        <div>
                            <h6 class="text-muted text-uppercase small">Nº de Ticket</h6>
                            <h4 class="fw-bold">#@ViewBag.TicketId</h4>
                        </div>
                        <div class="text-end">
                            <h6 class="text-muted text-uppercase small">Fecha de Compra</h6>
                            <p class="mb-0">@ViewBag.FechaCompra</p>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-sm-7">
                            <h3 class="text-primary fw-bold">@Model.MovieTitle</h3>
                            <p class="fs-5 mb-1">Sala @Model.RoomNumber</p>
                            <p class="text-muted">@Model.SessionTime</p>
                        </div>
                        <div class="col-sm-5 text-sm-end">
                            <h6 class="text-muted text-uppercase small">Asientos</h6>
                            <p class="fw-bold fs-5">@string.Join(", ", Model.SelectedSeats)</p>
                        </div>
                    </div>

                    @if (Model.Addons.Any())
                    {
                        <div class="bg-light p-3 rounded mb-4">
                            <h6 class="text-muted text-uppercase small mb-2">Complementos (Addons)</h6>
                            @foreach (var item in Model.Addons)
                            {
                                <div class="d-flex justify-content-between small">
                                    <span>@item.Quantity x @item.Name</span>
                                    <span>@((item.Quantity * item.UnitPrice).ToString("0.00")) €</span>
                                </div>
                            }
                        </div>
                    }

                    <div class="border-top pt-3">
                        <div class="d-flex justify-content-between">
                            <span>Subtotal:</span>
                            <span>@((Model.SeatsSubtotal + Model.AddonsTotal).ToString("0.00")) €</span>
                        </div>
                        @if (Model.DescuentoPuntos > 0)
                        {
                            <div class="d-flex justify-content-between text-danger">
                                <span>Descuento aplicado:</span>
                                <span>-@Model.DescuentoPuntos.ToString("0.00") €</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between mt-2 pt-2 border-top">
                            <h4 class="fw-bold">TOTAL PAGADO:</h4>
                            <h4 class="fw-bold text-success">@Model.TotalGeneral.ToString("0.00") €</h4>
                        </div>
                        <div class="mt-2 text-muted small">
                            <i class="bi bi-wallet2"></i> Método de pago: <strong>@ViewBag.MetodoPago</strong>
                        </div>
                    </div>
                    <div class="text-center mt-5 border-top pt-4">
                        <div id="qrcode"
                             data-ticket-id="@ViewBag.TicketId"
                             class="d-inline-block p-2 bg-white border">
                        </div>
                        <p class="text-muted small mt-2">Escanee este código en la entrada de la sala</p>
                    </div>
                </div>

                <div class="card-footer bg-light text-center py-3">
                    <button onclick="window.print();" class="btn btn-outline-dark btn-sm me-2">
                        <i class="bi bi-printer"></i> Imprimir Ticket
                    </button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-sm">
                        Finalizar y Salir
                    </a>
                </div>
            </div>

            <p class="text-center mt-4 text-muted small">
                Se ha enviado una copia de este ticket a <strong>@User.Identity.Name</strong>
            </p>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

    <script src="~/js/ticket-qr.js" asp-append-version="true"></script>
} *@