@{
    ViewData["Title"] = "Seleccionar Pago";
    bool isEmployee = ViewBag.IsEmployee ?? false;
}

@section Styles {
    <link rel="stylesheet" href="~/css/payment.css" />
}

<div class="container mt-5 payment-main-container">
    <div class="payment-header mb-5">
        <h3 class="display-6 highlight-gold">¿Cómo desea realizar el pago?</h3>
        <p class="text-muted letter-spacing-2">Seleccione un método para finalizar su reserva</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <form asp-action="ProcessPurchase" method="post" class="payment-form">
                @Html.AntiForgeryToken()

                <div class="payment-options-grid">
                    @* Opción: Tarjeta *@
                    <label class="payment-card card-visa">
                        <input type="radio" name="paymentMethod" value="Tarjeta" checked>
                        <div class="card-content">
                            <div class="icon-box"><i class="bi bi-credit-card-2-front"></i></div>
                            <div class="text-box">
                                <span class="method-title">Tarjeta de Crédito / Débito</span>
                                <span class="method-desc">Pago seguro mediante pasarela bancaria</span>
                            </div>
                            <div class="floating-bg card-slide"></div>
                        </div>
                    </label>

                    @* Opción: Efectivo (Solo empleados) *@
                    @if (ViewBag.IsEmployee == true)
                    {
                        <label class="payment-card card-cash mt-3">
                            <input type="radio" name="paymentMethod" value="Efectivo">
                            <div class="card-content">
                                <div class="icon-box"><i class="bi bi-cash-stack"></i></div>
                                <div class="text-box">
                                    <span class="method-title">Efectivo</span>
                                    <span class="method-desc">Cobro presencial en Taquilla Staff</span>
                                </div>
                                <div class="floating-bg cash-rain"></div>
                            </div>
                        </label>
                    }
                </div>

                <div class="mt-3 text-center">
                    <a asp-action="Index" class="btn btn-cancelar py-2">
                        Volver al resumen
                    </a>
                    <button type="submit" class="btn btn-continuar py-3">
                        Confirmar pago y finalizar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
