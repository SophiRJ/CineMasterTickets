@model CinemaMasterTicketsMVC.ViewModels.TicketViewModel

@{
    ViewData["Title"] = "Resumen de Compra";
}

<h2>Resumen de Compra</h2>
@* Detalles del Comprador *@
<div class="card mb-3">
    <div class="card-body">
        <h5 class="mb-3">Datos del Comprador</h5>

        <div class="row">
            <div class="col-sm-6">
                <p class="mb-1"><strong>Nombre:</strong> @(ViewBag.BuyerName ?? "Invitado")</p>
                <p class="mb-1"><strong>Correo:</strong> @ViewBag.BuyerEmail</p>
            </div>
            <div class="col-sm-6">
                <p class="mb-1"><strong>Tipo:</strong> @ViewBag.BuyerRole</p>

                @if (ViewBag.BuyerRole == "Empleado Staff")
                {
                    <p class="mb-0"><strong>Taquilla:</strong> @ViewBag.BoxOffice</p>
                }
                else if (ViewBag.BuyerRole == "Cliente VIP")
                {
                    <p class="mb-0 text-success"><strong>Puntos a conseguir:</strong> +@ViewBag.PuntosA_Acumular pts</p>
                }
                else
                {
                    <p class="mb-0 text-muted small"><em>Compra sin beneficios VIP</em></p>
                }
            </div>
        </div>
    </div>
</div>


<div class="card mb-3">
    <div class="card-body">
        <h4 class="card-title">@Model.MovieTitle</h4>
        <p><strong>Sala:</strong> @Model.RoomNumber</p>
        <p><strong>Hora sesión:</strong> @Model.SessionTime</p>
        <p><strong>Asientos seleccionados:</strong> @string.Join(", ", Model.SelectedSeats)</p>
        <p><strong>Subtotal asientos:</strong> @Model.SeatsSubtotal €</p>
    </div>
</div>

@if (Model.Addons.Any())
{
    <div class="card mb-3">
        <div class="card-body">
            <h5>Addons seleccionados</h5>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Precio unitario</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var addon in Model.Addons)
                    {
                        <tr>
                            <td>@addon.Name</td>
                            <td>@addon.Quantity</td>
                            <td>@addon.UnitPrice €</td>
                            <td>@addon.Total €</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="card">
    <div class="card-body">
        <h5>Total General: @Model.TotalGeneral €</h5>
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Volver a inicio</a>
    <a asp-controller="Payment" asp-action="Checkout" class="btn btn-primary">Proceder al pago</a>
</div>
