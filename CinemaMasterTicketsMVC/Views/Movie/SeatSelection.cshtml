@model CinemaMasterTicketsMVC.ViewModels.SeatSelectionViewModel

<div class="container mt-5">
    @*  *@
    <h2>@Model.MovieTitle - @Model.StartTime.ToString("dd/MM/yyyy HH:mm")</h2>
    <h4>Sala @Model.RoomId</h4>

    <div class="screen">PANTALLA</div>

    <form asp-controller="Movie" asp-action="SeatSelectionPost" method="post">
        <input asp-for="SessionId" type="hidden" />
        <input asp-for="Price" type="hidden" />
        <input asp-for="SelectedSeats" type="hidden" />
        <input asp-for="SelectedSeatNames" type="hidden" />
        <input asp-for="SeatUserTypes" type="hidden" />
        <input asp-for="TotalSeatsPrice" type="hidden" step="0.01" min="0.01" />
        <input type="hidden"
               id="pricePerSeatData"
               value="@Model.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
    
        <div class="seat-map">
            @foreach (var row in Model.SeatMap)
            {
                <div class="seat-row">
                    <span class="row-label">@row.Row</span>
                    @foreach (var seat in row.Seats)
                    {
                        @* La lógica de clases se mantiene idéntica a la original *@
                        <div class="seat
                             @(seat.IsReserved ? "reserved" : "available")
                             @(seat.IsSelected ? "selected" : "")"
                             data-seat-id="@seat.SeatId"
                             data-seat-label="@row.Row@seat.Number">
                            @seat.Number
                        </div>
                    }
                </div>
            }
        </div>
        <div class="selected-seats-container mt-3">
            <strong>Asientos seleccionados: </strong><span id="selectedSeatsDiv"></span>
            <br />
            <strong>IDs seleccionados: </strong><span id="selectedSeatIdsDiv"></span>
            <br />
            <strong>Tipos de usuario: </strong><span id="selectedSeatTypesDiv"></span>
            
        </div>
        <div id="userTypeContainer"></div>

        <div class="mt-2">
            <strong>Total Butacas: </strong>
            <span id="totalPriceDiv" class="text-success fw-bold">0,00 €</span>
        </div>
        @* Mensaje de error si no hay asientos seleccionados *@
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="d-flex gap-3 mt-4">
            <button type="submit" class="btn btn-primary px-4">
                Continuar
            </button>

            <a asp-controller="Movie" asp-action="CancelPurchase" class="btn btn-outline-danger px-4">
                Cancelar y volver
            </a>
        </div>
    </form>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/seats.css" />
}

@section Scripts {
    <script src="~/js/seats.js"></script>
}


