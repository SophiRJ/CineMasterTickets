@model CinemaMasterTicketsMVC.ViewModels.AddOnsViewModel

@{
    ViewData["Title"] = "AddOns";
}
<input type="hidden" id="seatsSubtotalRaw" value="@ViewBag.SeatsSubtotalRaw" />

<div class="movie-header text-center mb-4 mt-5">
    <h2 class="movie-title">@ViewBag.MovieTitle</h2>
    <p class="movie-datetime mb-1">
        Sesión: @ViewBag.SessionTime
    </p>
    <p class="movie-room">
        Sala @ViewBag.RoomId
    </p>
</div>
@* Selector para elegir el tipo de Complemento *@
<form asp-controller="Movie" asp-action="ConfirmAddons" method="post" id="addonsForm">
    <input type="hidden" name="addonsData" id="addonsDataInput" />
    <div class="mb-3 col-md-2">
        <label asp-for="SelectedType" class="form-label label-select">Selecciona un tipo:</label>
        <select asp-for="SelectedType" asp-items="Model.AddOnTypesSelectList" class="form-select" id="addonTypeSelect">
            <option value="">Todos</option>
        </select>
    </div>

    @* Aquí se generará dinámicamente la tabla de addons con JS *@
    <div id="addonsTableContainer"></div>
    <div class="mt-3">
        <strong class="fs-3">Total general: </strong>
        <span id="grandTotal" class="fs-3 fw-bold total-green">
            @($"{ViewBag.SeatsSubtotal:N2} €")
        </span>
    </div>
    

    <div class="mt-3">
        <button type="submit" class="btn btn-continuar me-2">Continuar</button>

        <a asp-controller="Movie"
           asp-action="SeatSelection"
           asp-route-sessionId="@ViewBag.SessionId"
           class="btn btn-cancelar">
            Volver
        </a>
    </div>
</form>

@section Scripts {
    <script src="~/js/addOnsList.js"></script>
}
@section Styles {
    <link rel="stylesheet" href="~/css/seatAddOn.css" />
}

